# Read access. Keep false in production unless the deployment is intentionally public.
OUTBOUND_ALLOW_ANONYMOUS_READ=true

# Localhost-only admin bypass. Keep false/absent in every deployment.
OUTBOUND_ALLOW_LOCAL_ADMIN=false

# Users allowed to save connector settings, sync, assign, or change rules.
OUTBOUND_ADMIN_EMAILS=supervisor@example.com,operations-lead@example.com

# Shared token for admin sign-in at /masuk. Required on deployments without a
# platform auth proxy, such as Docker or Coolify. Minimum 32 characters.
OUTBOUND_ADMIN_TOKEN=replace-with-a-random-secret-at-least-32-characters

# Whether the oai-authenticated-user-email header may be trusted as identity.
# Only true when an auth proxy controls that header. The container image sets
# it to false because a plain reverse proxy forwards client headers unchanged.
OUTBOUND_TRUST_PLATFORM_AUTH=true

# Active warehouse profile. The snapshot model is ready to carry this identity.
OUTBOUND_WAREHOUSE_CODE=CBT
OUTBOUND_WAREHOUSE_NAME=CBT - WH Cibitung
OUTBOUND_WAREHOUSE_TIMEZONE=Asia/Jakarta

# Restricts configurable Superset base URLs and prevents arbitrary outbound hosts.
SUPERSET_ALLOWED_HOSTS=superset.example.com

# Optional bootstrap configuration. Values saved from the Configuration page
# override these non-secret defaults.
SUPERSET_BASE_URL=https://superset.example.com
SUPERSET_SO_SLICE_ID=123
SUPERSET_STAFF_SLICE_ID=456
SUPERSET_EXPORT_PATH_TEMPLATE=/api/v1/chart/{sliceId}/data/?format=json&type=full&force=true
SUPERSET_REFRESH_INTERVAL_MINUTES=5

# Optional. Without it the runtime generates a key on first use and keeps it in
# D1, which survives redeploys. Set this only when the key must live outside the
# database that holds the encrypted cookie. Use 32+ random characters.
SUPERSET_COOKIE_ENCRYPTION_KEY=replace-with-a-random-secret-at-least-32-characters

# Optional alternative to UI-managed encrypted cookies. Server-side only.
SUPERSET_SESSION_COOKIE=session=replace-me
SUPERSET_COOKIE_EXPIRES_AT=2026-07-31T23:59:59+07:00

# Berapa lama sesi masuk admin bertahan, dalam hari. Default 30, maksimum 365.
# Mencabut akses tidak menunggu ini: hapus email dari OUTBOUND_ADMIN_EMAILS.
OUTBOUND_ADMIN_SESSION_DAYS=30

# Batas ukuran export Superset sebelum sync ditolak, dalam MB. Default 45.
SUPERSET_EXPORT_MAX_MB=45

# Set ke csv agar export jauh lebih kecil: nama kolom ditulis sekali, tidak
# diulang pada setiap baris. Metadata applied_filters hanya ada pada json.
SUPERSET_EXPORT_FORMAT=csv
